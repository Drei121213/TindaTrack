<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tindatrack.credit.RecordUtangController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
            stylesheets="@../css/credit.css">
    <StackPane styleClass="login-root">
        <VBox spacing="12" maxWidth="440" maxHeight="-Infinity" styleClass="login-card">
            <Label text="Record Utang" styleClass="credit-title" />
            <VBox fx:id="fields" spacing="10">
                <VBox spacing="5">
                    <Label text="Customer *" styleClass="field-label" />
                    <ComboBox fx:id="customerField" promptText="Select a customer" editable="false"
                              accessibleText="Existing customer" maxWidth="Infinity" />
                    <CheckBox fx:id="newCustomer" text="New customer" />
                    <VBox fx:id="newCustomerFields" spacing="5">
                        <Label text="New Customer Name *" styleClass="field-label" />
                        <TextField fx:id="customerNameField" promptText="Enter customer name"
                                   accessibleText="New customer name" />
                    </VBox>
                    <Label fx:id="customerError" visible="false" managed="false" wrapText="true" styleClass="registration-error" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Items Purchased" styleClass="field-label" />
                    <TextArea fx:id="itemsField" promptText="e.g. 2 Pancit Canton, 1 Coke"
                              accessibleText="Items purchased" wrapText="true" prefRowCount="2" />
                    <Label fx:id="itemsError" visible="false" managed="false" wrapText="true" styleClass="registration-error" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Amount (₱) *" styleClass="field-label" />
                    <TextField fx:id="amountField" promptText="0.00" accessibleText="Credit amount" />
                    <Label fx:id="amountError" visible="false" managed="false" wrapText="true" styleClass="registration-error" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Date" styleClass="field-label" />
                    <DatePicker fx:id="dateField" editable="false" accessibleText="Credit date" maxWidth="Infinity" />
                    <Label fx:id="dateError" visible="false" managed="false" wrapText="true" styleClass="registration-error" />
                </VBox>
            </VBox>
            <Label fx:id="formError" visible="false" managed="false" wrapText="true" styleClass="registration-error" />
            <Button fx:id="retryButton" text="Retry loading customers" visible="false" managed="false"
                    onAction="#loadCustomers" styleClass="guest-button" />
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="cancelButton" text="Cancel" cancelButton="true" onAction="#closeForm" styleClass="guest-button" />
                <Button fx:id="saveButton" text="Save" defaultButton="true" onAction="#handleSave" styleClass="login-button" />
            </HBox>
        </VBox>
    </StackPane>
</ScrollPane>
