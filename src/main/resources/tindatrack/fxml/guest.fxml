<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tindatrack.guest.GuestController"
      spacing="12" styleClass="login-root">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Guest Mode" styleClass="login-title" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Exit Guest Mode" onAction="#handleExitGuest" styleClass="guest-button" />
    </HBox>
    <Label text="View only. Sign in as the owner to make changes."
           wrapText="true" styleClass="field-label" />

    <TabPane fx:id="guestTabs" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <Tab text="Products">
            <VBox spacing="10" styleClass="login-card">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <TextField fx:id="searchField" accessibleText="Product name"
                               promptText="Search by product name" onAction="#searchProducts"
                               HBox.hgrow="ALWAYS" />
                    <Button fx:id="searchButton" text="Search" onAction="#searchProducts"
                            styleClass="login-button" />
                </HBox>
                <TableView fx:id="productsTable" editable="false" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="productName" text="Product" prefWidth="190" />
                        <TableColumn fx:id="productPrice" text="Price (₱)" prefWidth="82" />
                        <TableColumn fx:id="productStock" text="Stock" prefWidth="65" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>
        <Tab fx:id="creditTab" text="Credit (Utang)">
            <VBox spacing="10" styleClass="login-card">
                <Button fx:id="refreshCreditButton" text="Refresh balances" onAction="#loadBalances"
                        styleClass="guest-button" />
                <TableView fx:id="balancesTable" editable="false" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="customerName" text="Customer" prefWidth="200" />
                        <TableColumn fx:id="customerBalance" text="Balance (₱)" prefWidth="130" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
