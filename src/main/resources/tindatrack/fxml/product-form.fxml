<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tindatrack.inventory.ProductFormController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
    <StackPane styleClass="login-root">
        <VBox spacing="14" maxWidth="420" maxHeight="-Infinity" styleClass="login-card">
            <Label text="Add Product" styleClass="login-title" />
            <VBox fx:id="fields" spacing="12">
                <VBox spacing="5">
                    <Label text="Product Name *" styleClass="field-label" />
                    <TextField fx:id="nameField" accessibleText="Product Name"
                               promptText="e.g. Lucky Me Pancit Canton" />
                    <Label fx:id="nameError" visible="false" managed="false"
                           wrapText="true" styleClass="registration-error" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Price (₱) *" styleClass="field-label" />
                    <TextField fx:id="priceField" accessibleText="Price" promptText="0.00" />
                    <Label fx:id="priceError" visible="false" managed="false"
                           wrapText="true" styleClass="registration-error" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Stock Quantity *" styleClass="field-label" />
                    <TextField fx:id="stockField" accessibleText="Stock Quantity" promptText="0" />
                    <Label fx:id="stockError" visible="false" managed="false"
                           wrapText="true" styleClass="registration-error" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Expiration Date" styleClass="field-label" />
                    <DatePicker fx:id="expirationField" accessibleText="Expiration Date"
                                promptText="YYYY-MM-DD" editable="false" maxWidth="Infinity" />
                    <CheckBox fx:id="noExpiration" text="No expiration date" />
                    <Label fx:id="dateError" visible="false" managed="false"
                           wrapText="true" styleClass="registration-error" />
                </VBox>
            </VBox>
            <Label fx:id="formError" visible="false" managed="false"
                   wrapText="true" styleClass="registration-error" />
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="cancelButton" text="Cancel" cancelButton="true"
                        onAction="#closeForm" styleClass="guest-button" />
                <Button fx:id="saveButton" text="Save" defaultButton="true"
                        onAction="#handleSave" styleClass="login-button" />
            </HBox>
        </VBox>
    </StackPane>
</ScrollPane>
