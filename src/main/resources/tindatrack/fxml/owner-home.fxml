<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tindatrack.core.OwnerHomeController"
           styleClass="login-root">
    <VBox alignment="CENTER" spacing="16" maxWidth="420" maxHeight="-Infinity"
          styleClass="login-card">
        <Label text="Dashboard" styleClass="page-title" />
        <Label fx:id="ownerGreeting" wrapText="true" textAlignment="CENTER"
               styleClass="login-title" />
        <Label text="Choose Inventory, Credit Management, or Expiring Soon from the sidebar to manage your store." wrapText="true"
               textAlignment="CENTER" styleClass="login-subtitle" />
    </VBox>
</StackPane>
