<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tindatrack.core.OwnerHomeController"
           styleClass="page-root" spacing="12">
    <Label text="Dashboard" styleClass="page-title" />
    <Label fx:id="ownerGreeting" wrapText="true" styleClass="dashboard-greeting" />
    <Label text="A quick view of your inventory and outstanding customer credit."
           wrapText="true" styleClass="page-subtitle" />
    <HBox>
        <Button fx:id="dashboardRefreshButton" text="Refresh Summary" onAction="#loadSummary"
                styleClass="guest-button" />
    </HBox>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="140" VBox.vgrow="ALWAYS"
                styleClass="dashboard-scroll">
        <FlowPane hgap="12" vgap="12" prefWrapLength="700">
            <VBox prefWidth="225" minWidth="225" spacing="10" styleClass="summary-card">
                <Label text="Total Products" styleClass="field-label" />
                <Label fx:id="totalProducts" text="—" wrapText="true" minHeight="-Infinity"
                       maxWidth="Infinity" styleClass="summary-value" />
                <Label text="Products in inventory" wrapText="true" styleClass="page-subtitle" />
            </VBox>
            <VBox prefWidth="225" minWidth="225" spacing="10" styleClass="summary-card">
                <Label text="Total Credits" styleClass="field-label" />
                <Label fx:id="totalCredits" text="—" wrapText="true" minHeight="-Infinity"
                       maxWidth="Infinity" styleClass="summary-value,summary-money" />
                <Label text="Outstanding customer balances" wrapText="true" styleClass="page-subtitle" />
            </VBox>
            <VBox prefWidth="225" minWidth="225" spacing="10" styleClass="summary-card">
                <Label text="Expiring Soon" styleClass="field-label" />
                <Label fx:id="expiringProducts" text="—" wrapText="true" minHeight="-Infinity"
                       maxWidth="Infinity" styleClass="summary-value" />
                <Label text="Expired and next 7 days" wrapText="true" styleClass="page-subtitle" />
            </VBox>
        </FlowPane>
    </ScrollPane>
    <Label fx:id="dashboardRange" wrapText="true" styleClass="page-subtitle"
           text="Expiration count includes expired items and products due within 7 days." />
    <Label fx:id="dashboardStatus" wrapText="true" minHeight="24" styleClass="dashboard-status" />
</VBox>
