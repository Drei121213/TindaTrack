<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tindatrack.credit.RecordPaymentController" stylesheets="@../css/credit.css">
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="form-scroll">
            <StackPane styleClass="login-root">
                <VBox spacing="14" maxWidth="440" maxHeight="-Infinity" styleClass="login-card">
                    <Label text="Record Payment" styleClass="credit-title"/>
                    <Label text="Fields marked * are required." styleClass="form-hint"/>
                    <VBox fx:id="fields" spacing="12">
                        <Label fx:id="customerLabel" text="Customer:" wrapText="true" styleClass="field-label"/>
                        <Label fx:id="balanceLabel" text="Current Balance:" wrapText="true" maxWidth="Infinity" styleClass="balance-summary"/>
                        <VBox spacing="5">
                            <Label text="Payment Amount (₱) *" styleClass="field-label"/>
                            <TextField fx:id="amountField" promptText="0.00" accessibleText="Payment amount"/>
                            <Label fx:id="amountError" visible="false" managed="false" wrapText="true" styleClass="registration-error"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Date" styleClass="field-label"/>
                            <DatePicker fx:id="dateField" editable="false" accessibleText="Payment date" maxWidth="Infinity"/>
                            <Label fx:id="dateError" visible="false" managed="false" wrapText="true" styleClass="registration-error"/>
                        </VBox>
                        <Label fx:id="newBalanceLabel" text="New Balance: —" wrapText="true" maxWidth="Infinity" styleClass="balance-summary"/>
                    </VBox>
                    <Label fx:id="formError" visible="false" managed="false" wrapText="true" styleClass="registration-error"/>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-actions">
            <Button fx:id="cancelButton" text="Cancel" cancelButton="true" onAction="#closeForm" styleClass="guest-button"/>
            <Button fx:id="saveButton" text="Save" defaultButton="true" onAction="#handleSave" styleClass="login-button"/>
        </HBox>
    </bottom>
</BorderPane>
