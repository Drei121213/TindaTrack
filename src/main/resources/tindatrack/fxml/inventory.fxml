<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tindatrack.inventory.InventoryController"
      styleClass="login-root" stylesheets="@../css/inventory.css" spacing="12">
    <Button text="Back to Home" onAction="#handleBack" styleClass="guest-button" />
    <Label text="Inventory Management" styleClass="inventory-title" />

    <HBox alignment="CENTER_LEFT" spacing="8">
        <TextField promptText="Search by product name" accessibleText="Product name"
                   onAction="#handleSearch" HBox.hgrow="ALWAYS" />
        <Button text="Search" onAction="#handleSearch" styleClass="login-button" />
    </HBox>

    <FlowPane hgap="8" vgap="8">
        <Button text="Add Product" onAction="#handleAddProduct" styleClass="login-button" />
        <Button text="Edit Product" onAction="#handleEditProduct" styleClass="guest-button" />
        <Button text="Delete Product" onAction="#handleDeleteProduct" styleClass="guest-button" />
        <Button text="Refresh" onAction="#handleRefresh" styleClass="guest-button" />
    </FlowPane>

    <TableView fx:id="productsTable" editable="false" VBox.vgrow="ALWAYS"
               styleClass="inventory-table">
        <columns>
            <TableColumn text="Product ID" minWidth="70" prefWidth="85" />
            <TableColumn text="Product Name" minWidth="100" prefWidth="180" />
            <TableColumn text="Price (₱)" minWidth="64" prefWidth="88" />
            <TableColumn text="Stock" minWidth="48" prefWidth="65" />
            <TableColumn text="Expiration Date" minWidth="104" prefWidth="148" />
        </columns>
        <placeholder>
            <Label text="No products to display yet." styleClass="inventory-status" />
        </placeholder>
    </TableView>

    <Label fx:id="statusLabel" wrapText="true" minHeight="24" styleClass="inventory-status" />
</VBox>
