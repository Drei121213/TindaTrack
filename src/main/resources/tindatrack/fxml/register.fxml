<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tindatrack.authentication.RegistrationController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
    <content>
        <StackPane styleClass="login-root">
            <VBox spacing="14" maxWidth="420" maxHeight="-Infinity" styleClass="login-card">
                <Label text="Create Store Owner Account" wrapText="true"
                       styleClass="registration-title" />
                <VBox fx:id="formFields" spacing="12">
                    <VBox spacing="5">
                        <Label text="Full Name *" styleClass="field-label" />
                        <TextField fx:id="fullNameField" accessibleText="Full Name"
                                   promptText="Enter your full name" />
                        <Label fx:id="fullNameError" visible="false" managed="false"
                               wrapText="true" styleClass="registration-error" />
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Username *" styleClass="field-label" />
                        <TextField fx:id="usernameField" accessibleText="Username"
                                   promptText="Choose a username" />
                        <Label fx:id="usernameError" visible="false" managed="false"
                               wrapText="true" styleClass="registration-error" />
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Password *" styleClass="field-label" />
                        <PasswordField fx:id="passwordField" accessibleText="Password"
                                       promptText="At least 6 characters" />
                        <Label fx:id="passwordError" visible="false" managed="false"
                               wrapText="true" styleClass="registration-error" />
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Confirm Password *" styleClass="field-label" />
                        <PasswordField fx:id="confirmationField" accessibleText="Confirm Password"
                                       promptText="Type the password again" />
                        <Label fx:id="confirmationError" visible="false" managed="false"
                               wrapText="true" styleClass="registration-error" />
                    </VBox>
                </VBox>
                <Label fx:id="formError" visible="false" managed="false"
                       wrapText="true" styleClass="registration-error" />
                <Label fx:id="saveStatus" text="Creating account..." visible="false"
                       managed="false" styleClass="login-subtitle" />
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="cancelButton" text="Cancel" cancelButton="true"
                            onAction="#closeForm" styleClass="guest-button" />
                    <Button fx:id="createButton" text="Create Account" defaultButton="true"
                            onAction="#handleCreateAccount" styleClass="login-button" />
                </HBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
